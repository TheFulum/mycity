<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <org.osmdroid.views.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/surface_scrim"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_all"
                style="@style/FilterChip"
                android:text="@string/transport_filter_all" />

            <TextView
                android:id="@+id/chip_bus"
                style="@style/FilterChip"
                android:layout_marginStart="8dp"
                android:text="@string/transport_filter_bus" />

            <TextView
                android:id="@+id/chip_tram"
                style="@style/FilterChip"
                android:layout_marginStart="8dp"
                android:text="@string/transport_filter_tram" />

            <TextView
                android:id="@+id/chip_trolleybus"
                style="@style/FilterChip"
                android:layout_marginStart="8dp"
                android:text="@string/transport_filter_trolleybus" />

            <TextView
                android:id="@+id/chip_marshrutka"
                style="@style/FilterChip"
                android:layout_marginStart="8dp"
                android:text="@string/transport_filter_marshrutka" />
        </LinearLayout>
    </HorizontalScrollView>
</FrameLayout>
